{
  "name": "@softwareifycz/ui-components",
  "version": "0.3.2",
  "description": "Shared UI components for Softwareify projects",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.es.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "dayjs": ">=1.11.0",
    "i18next": ">=23.0.0",
    "react": ">=18.0.0",
    "react-dnd": ">=16.0.0",
    "react-dnd-html5-backend": ">=16.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=14.0.0",
    "react-resize-detector": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "react-dnd": {
      "optional": true
    },
    "react-dnd-html5-backend": {
      "optional": true
    },
    "react-resize-detector": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@chromatic-com/storybook": "^5.1.1",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/addon-onboarding": "^10.3.4",
    "@storybook/addon-vitest": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@types/node": "^22.5.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "antd": "^6.0.0",
    "dayjs": "^1.11.13",
    "eslint": "^9.39.1",
    "i18next": "^24.1.2",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-resize-detector": "^12.0.2",
    "storybook": "^10.3.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwareifycz/Softwareify.UI.Components.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "PRIVATE"
}
